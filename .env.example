# Backend (silicosis-backend). Bundled at build time: restart dev / rebuild after changing.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional, Playwright only (tests/live.spec.ts). Use test accounts, never real patients.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_PATIENT_EMAIL=
E2E_PATIENT_PASSWORD=
# 1 = allow the test that creates (and then deletes) a visit with a synthetic image.
E2E_WRITE=
